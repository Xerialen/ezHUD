{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changedrop-script-authoring/1",
  "title": "ezHUD per-release changedrop script authoring v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "setup", "bookends", "treatments"],
  "properties": {
    "schema_version": {"const": "changedrop-script-authoring/1"},
    "setup": {"$ref": "#/$defs/walkthrough"},
    "bookends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro_walkthrough", "outro_walkthrough"],
      "properties": {
        "intro_walkthrough": {"$ref": "#/$defs/fitWalkthrough"},
        "outro_walkthrough": {"$ref": "#/$defs/fitWalkthrough"}
      }
    },
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "source", "text", "walkthrough"],
        "properties": {
          "surface": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["before", "after", "value"],
            "properties": {
              "before": {"type": "string", "minLength": 1},
              "after": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          },
          "text": {"type": "string", "minLength": 1},
          "walkthrough": {"$ref": "#/$defs/fitWalkthrough"}
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "string",
      "pattern": "^(?:#[A-Za-z][A-Za-z0-9_-]{0,63}|\\[data-changedrop=\"[a-z0-9]+(?:-[a-z0-9]+)*\"\\])$"
    },
    "walkthrough": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "fitWalkthrough": {
      "allOf": [
        {"$ref": "#/$defs/walkthrough"},
        {
          "contains": {
            "type": "object",
            "required": ["action", "fit"],
            "properties": {
              "action": {"const": "hold"},
              "fit": {"const": "narration"}
            }
          },
          "minContains": 1
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction", "action", "selector", "state"],
          "properties": {
            "instruction": {"type": "string", "minLength": 1},
            "action": {"const": "wait-for"},
            "selector": {"$ref": "#/$defs/selector"},
            "state": {"enum": ["visible", "enabled", "pressed", "unpressed"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction", "action", "width", "height"],
          "properties": {
            "instruction": {"type": "string", "minLength": 1},
            "action": {"const": "resize"},
            "width": {"type": "integer", "minimum": 320, "maximum": 3840},
            "height": {"type": "integer", "minimum": 240, "maximum": 2160}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction", "action", "selector"],
          "properties": {
            "instruction": {"type": "string", "minLength": 1},
            "action": {"const": "click"},
            "selector": {"$ref": "#/$defs/selector"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction", "action", "duration_ms"],
          "properties": {
            "instruction": {"type": "string", "minLength": 1},
            "action": {"const": "hold"},
            "duration_ms": {"type": "integer", "minimum": 100, "maximum": 5000},
            "fit": {"const": "narration"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction", "action", "selector", "badge", "crop"],
          "properties": {
            "instruction": {"type": "string", "minLength": 1},
            "action": {"const": "highlight"},
            "selector": {"$ref": "#/$defs/selector"},
            "badge": {"type": "integer", "minimum": 1, "maximum": 99},
            "crop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": {"type": "integer", "minimum": 320, "maximum": 1200},
                "height": {"type": "integer", "minimum": 180, "maximum": 800}
              }
            }
          }
        }
      ]
    }
  }
}
