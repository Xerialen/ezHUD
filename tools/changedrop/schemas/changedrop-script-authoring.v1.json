{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changedrop-script-authoring/1",
  "title": "ezHUD per-release changedrop script authoring v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bookends", "treatments"],
  "properties": {
    "schema_version": {
      "const": "changedrop-script-authoring/1"
    },
    "bookends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro_walkthrough", "outro_walkthrough"],
      "properties": {
        "intro_walkthrough": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "outro_walkthrough": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "source", "text", "walkthrough"],
        "properties": {
          "surface": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["before", "after", "value"],
            "properties": {
              "before": {"type": "string", "minLength": 1},
              "after": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "walkthrough": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
