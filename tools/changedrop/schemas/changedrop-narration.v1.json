{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changedrop-narration/1",
  "title": "ezHUD changedrop narration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "voice_profile", "segments"],
  "properties": {
    "schema_version": {"const": "changedrop-narration/1"},
    "project": {"const": "ezhud"},
    "voice_profile": {"const": "xeri-en-v1"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "surface",
          "request_id",
          "request_hash",
          "status",
          "rerendered",
          "profile_revision",
          "pronunciation_profile",
          "pronunciation_revision",
          "normalized_text_sha256",
          "audio",
          "duration_seconds",
          "engine",
          "rendered_at"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["bookend", "surface"]},
          "surface": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "request_id": {"type": "string", "pattern": "^ezhud-[0-9a-f]{32}$"},
          "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["rendered", "duplicate"]},
          "rerendered": {"type": "boolean"},
          "profile_revision": {"type": "integer", "minimum": 1},
          "pronunciation_profile": {"type": "string", "minLength": 1},
          "pronunciation_revision": {"type": "integer", "minimum": 0},
          "normalized_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basename", "sha256"],
            "properties": {
              "basename": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.wav$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "engine": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "t3_model", "cli_sha256"],
            "properties": {
              "name": {"const": "chatterbox-multilingual"},
              "t3_model": {"type": "string", "minLength": 1},
              "cli_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "rendered_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
