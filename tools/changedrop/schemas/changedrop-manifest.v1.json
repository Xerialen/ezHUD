{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changedrop-manifest/1",
  "title": "ezHUD changedrop pipeline manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "run_id",
    "source_note",
    "decision",
    "blocked_reason",
    "segments",
    "capture",
    "output",
    "publish"
  ],
  "properties": {
    "schema_version": {"const": "changedrop-manifest/1"},
    "release": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^docs/[a-z0-9][a-z0-9._-]*/NOTES\\.md$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "decision": {"enum": ["render", "skip", "blocked"]},
    "blocked_reason": {"type": ["string", "null"], "minLength": 1},
    "segments": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface",
          "script_sha256",
          "measured_start_s",
          "measured_duration_s",
          "narration"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "surface": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "measured_start_s": {"type": "number", "minimum": 0},
          "measured_duration_s": {"type": "number", "exclusiveMinimum": 0},
          "narration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basename",
              "sha256",
              "duration_s",
              "voice_profile",
              "profile_revision",
              "request_status",
              "engine"
            ],
            "properties": {
              "basename": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.wav$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "duration_s": {"type": "number", "exclusiveMinimum": 0},
              "voice_profile": {"const": "xeri-en-v1"},
              "profile_revision": {"type": "integer", "minimum": 1},
              "request_status": {"enum": ["rendered", "duplicate"]},
              "engine": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "t3_model", "cli_sha256"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "t3_model": {"type": "string", "minLength": 1},
                  "cli_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      }
    },
    "capture": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["basename", "sha256", "duration_s"],
      "properties": {
        "basename": {"const": "walkthrough.webm"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "output": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["basename", "sha256", "duration_s"],
      "properties": {
        "basename": {"const": "changedrop.mp4"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "destination"],
      "properties": {
        "state": {"const": "withheld"},
        "destination": {"type": "null"}
      }
    }
  }
}
