{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changedrop-voice-fit/1",
  "title": "ezHUD changedrop natural narration fit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "voice_profile", "script", "segments"],
  "properties": {
    "schema_version": {"const": "changedrop-voice-fit/1"},
    "project": {"const": "ezhud"},
    "voice_profile": {"const": "xeri-en-v1"},
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "sha256"],
      "properties": {
        "basename": {"const": "script.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "kind", "surface", "request_id", "request_hash", "status", "rerendered",
          "audio", "natural_duration_seconds", "measured_window_seconds", "fixed_action_seconds",
          "previous_padding_ms", "fitted_padding_ms", "fitted_hold_durations_ms",
          "projected_duration_seconds"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["bookend", "surface"]},
          "surface": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "request_id": {"type": "string", "pattern": "^ezhud-[0-9a-f]{32}$"},
          "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["rendered", "duplicate"]},
          "rerendered": {"type": "boolean"},
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basename", "sha256"],
            "properties": {
              "basename": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.wav$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "natural_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "measured_window_seconds": {"type": "number", "exclusiveMinimum": 0},
          "fixed_action_seconds": {"type": "number", "minimum": 0},
          "previous_padding_ms": {"type": "integer", "minimum": 100},
          "fitted_padding_ms": {"type": "integer", "minimum": 100},
          "fitted_hold_durations_ms": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 100, "maximum": 5000}
          },
          "projected_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
