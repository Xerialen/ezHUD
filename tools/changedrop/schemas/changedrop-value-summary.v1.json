{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changedrop-value-summary/1",
  "title": "ezHUD changedrop value summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "skip_reason",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "changedrop-value-summary/1"
    },
    "decision": {
      "enum": ["render", "skip"]
    },
    "skip_reason": {
      "type": ["string", "null"]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "surface", "value", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "pattern": "^img/[^/\\s]+\\.png$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["decision"],
        "properties": {
          "decision": {"const": "render"}
        }
      },
      "then": {
        "properties": {
          "skip_reason": {"type": "null"},
          "features": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "required": ["decision"],
        "properties": {
          "decision": {"const": "skip"}
        }
      },
      "then": {
        "properties": {
          "skip_reason": {"type": "string", "minLength": 1},
          "features": {"maxItems": 0}
        }
      }
    }
  ]
}
