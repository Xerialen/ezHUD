+/* Growable sink for Image_EncodePNG. */
+typedef struct {
+	byte *data;
+	size_t length;
+	size_t capacity;
+	qbool failed;
+} png_membuf_t;
+
+static void PNG_IO_mem_write_data(png_structp png_ptr, png_bytep data, png_size_t length)
+{
+	png_membuf_t *b = (png_membuf_t *) png_get_io_ptr(png_ptr);
+
+	if (b->failed) {
+		return;
+	}
+	if (b->length + length > b->capacity) {
+		size_t want = b->capacity ? b->capacity * 2 : 256 * 1024;
+		byte *grown;
+
+		while (want < b->length + length) {
+			want *= 2;
+		}
+		if (!(grown = (byte *) Q_realloc(b->data, want))) {
+			b->failed = true;
+			return;
+		}
+		b->data = grown;
+		b->capacity = want;
+	}
+	memcpy(b->data + b->length, data, length);
+	b->length += length;
+}
+
+static void PNG_IO_mem_flush_data(png_structp png_ptr)
+{
+	(void) png_ptr;
+}
+
+/* Encode straight to a heap block. The caller owns the result and frees it with
+ * Q_free. Exists because the HUD bridge must not put a screenshot of the player's
+ * game on disk: a fixed path under /tmp is a symlink target another local user can
+ * point at any file the player can write, and the file would otherwise linger
+ * world-readable. Returns NULL on failure. */
+byte *Image_EncodePNG(int compression, byte *pixels, size_t width, size_t height, size_t *out_len)
+{
+	png_membuf_t buf;
+	png_structp png_ptr;
+	png_infop info_ptr;
+	png_byte **rowpointers;
+	size_t i;
+	const int bpp = 3;
+
+	memset(&buf, 0, sizeof(buf));
+
+	if (!(png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL))) {
+		return NULL;
+	}
+	if (!(info_ptr = png_create_info_struct(png_ptr))) {
+		png_destroy_write_struct(&png_ptr, (png_infopp) NULL);
+		return NULL;
+	}
+
+	png_set_write_fn(png_ptr, &buf, PNG_IO_mem_write_data, PNG_IO_mem_flush_data);
+	png_set_compression_level(png_ptr, bound(Z_NO_COMPRESSION, compression, Z_BEST_COMPRESSION));
+	png_set_IHDR(png_ptr, info_ptr, (png_uint_32)width, (png_uint_32)height, 8, PNG_COLOR_TYPE_RGB,
+		PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+	png_write_info(png_ptr, info_ptr);
+
+	rowpointers = (png_byte **) Q_malloc(height * sizeof(*rowpointers));
+	for (i = 0; i < height; i++) {
+		rowpointers[i] = pixels + (height - i - 1) * width * bpp;
+	}
+	png_write_image(png_ptr, rowpointers);
+	png_write_end(png_ptr, info_ptr);
+	Q_free(rowpointers);
+	png_destroy_write_struct(&png_ptr, &info_ptr);
+
+	if (buf.failed || !buf.length) {
+		Q_free(buf.data);
+		return NULL;
+	}
+	if (out_len) {
+		*out_len = buf.length;
+	}
+	return buf.data;
+}
+
