From 0bbfe56da2b75f9456c311c514e2e784f353f334 Mon Sep 17 00:00:00 2001
From: root <root@srv1843077.hstgr.cloud>
Date: Fri, 31 Jul 2026 19:05:24 +0000
Subject: [PATCH 5/6] hud: add hud_reset_layout, and report each element's
 registered defaults

The engine had no way to restore a HUD's placement. `reset` centres one element
and does not restore anything; `cfg_reset` resets everything the client owns,
which is far more than someone who has been dragging their HUD around wants to
lose. hud_reset_layout restores show/place/pos/align for every registered
element from cvar_t.defaultvalue, and reports how many values changed.

/state now carries those defaults per element so the editor can say exactly what
a reset would change before asking to do it, rather than offering a bare 'are
you sure'.

Also widens the command gate for HUD-type switching. Which HUD is drawn turns
out not to be one cvar: scr_newhud selects classic/new/both (cl_screen.c:107,
hud.c:1539, sbar.c:2412), cl_hud stacks the QW262 HUD on top of either
(cl_screen.c:113), and the classic bar's shape depends on cl_sbar and viewsize,
which are coupled -- viewsize below 100 forces standard mode, and 120 removes
the bar entirely via sb_lines (cl_screen.c:324).

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FqUfMu4JRqFSaazvAD6kyH
---
 src/hud.c | 41 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/src/hud.c b/src/hud.c
index 38e21db9..426d34d5 100644
--- a/src/hud.c
+++ b/src/hud.c
@@ -796,6 +796,46 @@ void HUD_Recalculate(void)
 		hud = hud->next;
 	}
 }
+/* Restore every element's position and visibility to what HUD_Register asked for.
+ *
+ * The engine has had no way to do this. `reset` (HUD_Reset_f) centres a single
+ * element, which is not the same thing and does not restore anything. `cfg_reset`
+ * resets everything the client owns, which is far more than someone who has been
+ * dragging their HUD around wants to lose. Deliberately limited to placement and
+ * visibility: colours, scales and per-element parameters are left alone, because
+ * "I moved things and want them back" is the request this answers.
+ */
+void HUD_ResetLayout_f(void)
+{
+	hud_t *hud;
+	int changed = 0;
+
+	for (hud = hud_huds; hud; hud = hud->next) {
+		cvar_t *vars[6];
+		int i;
+
+		vars[0] = hud->show;
+		vars[1] = hud->place;
+		vars[2] = hud->align_x;
+		vars[3] = hud->align_y;
+		vars[4] = hud->pos_x;
+		vars[5] = hud->pos_y;
+
+		for (i = 0; i < 6; i++) {
+			/* Not every element registers every one of these: HUD_Register is
+			 * given NULL for the ones that do not apply (hud.c:1287, 1300, 1313). */
+			if (vars[i] && strcmp(vars[i]->string, vars[i]->defaultvalue)) {
+				Cvar_Set(vars[i], vars[i]->defaultvalue);
+				changed++;
+			}
+		}
+	}
+
+	HUD_Recalculate();
+	Com_Printf("HUD layout reset: %d value%s restored to default\n",
+		changed, changed == 1 ? "" : "s");
+}
+
 void HUD_Recalculate_f(void)
 {
 	HUD_Recalculate();
@@ -819,6 +859,7 @@ void HUD_Init(void)
 	Cmd_AddCommand ("togglehud", HUD_Toggle_f);
 	Cmd_AddCommand ("align", HUD_Align_f);
 	Cmd_AddCommand ("hud_recalculate", HUD_Recalculate_f);
+	Cmd_AddCommand ("hud_reset_layout", HUD_ResetLayout_f);
 
 	// Variables.
 	Cvar_SetCurrentGroup(CVAR_GROUP_HUD);
-- 
