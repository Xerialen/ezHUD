+// ezQuake's 24-bit HUD art conventions: a gfx.wad lump is replaced by
+// textures/wad/<lump>.<ext>, a gfx/*.lmp pic by textures/gfx/<base>.<ext>.
+// FTE's material system has its own override paths and knows nothing of
+// these, so a player's HUD art pack mounted fine and then rendered stock.
+// Honour the convention here: if a replacement file exists, upload its bytes
+// over the engine's own texture name before the shader loads. This runs at
+// init time only (HUD_InitSbarImages, vid restarts, and the group-pic
+// OnChange) — never per frame.
+static qhandle_t EZHud_LoadReplaceable(const char *ftename, const char *base)
+{
+	static const char *dirs[] = {"textures/wad", "textures/gfx"};
+	static const char *exts[] = {"png", "tga", "jpg"};
+	char path[MAX_QPATH];
+	int d, e, size;
+	qhandle_t f, ret;
+	void *data;
+
+	for (d = 0; d < 2; d++)
+	{
+		for (e = 0; e < 3; e++)
+		{
+			Q_snprintf(path, sizeof(path), "%s/%s.%s", dirs[d], base, exts[e]);
+			size = filefuncs->Open(path, &f, 1);
+			if (size < 0)
+				continue;
+			ret = 0;
+			if (size > 0)
+			{
+				data = malloc(size);
+				if (data && filefuncs->Read(f, data, size) == size)
+					ret = drawfuncs->LoadImageData(ftename, path, data, size);
+				free(data);
+			}
+			filefuncs->Close(f);
+			if (ret)
+				return ret;
+		}
+	}
+	return drawfuncs->LoadImage(ftename);
+}
+
 mpic_t *Draw_CachePicSafe(const char *name, qbool crash, qbool ignorewad)
 {
+	char base[MAX_QPATH];
+	char *dot;
 	if (!*name)
 		return NULL;
+	// gfx/foo.lmp (or gfx/foo) may have a textures/gfx/foo.png replacement;
+	// the lookup wants the bare base name.
+	if (!strncmp(name, "gfx/", 4))
+	{
+		Q_strncpyz(base, name+4, sizeof(base));
+		dot = strrchr(base, '.');
+		if (dot)
+			*dot = 0;
+		return (mpic_t*)(qintptr_t)EZHud_LoadReplaceable(name, base);
+	}
 	return (mpic_t*)(qintptr_t)drawfuncs->LoadImage(name);
 }
 mpic_t *Draw_CacheWadPic(const char *name)
 {
 	char ftename[MAX_QPATH];
 	Q_snprintf(ftename, sizeof(ftename), "gfx/%s", name);
-	return (mpic_t*)(qintptr_t)drawfuncs->LoadImage(ftename);
+	return (mpic_t*)(qintptr_t)EZHud_LoadReplaceable(ftename, name);
 }
 
 mpic_t *SCR_LoadCursorImage(char *cursorimage)
diff --git a/plugins/ezhud/hud.c b/plugins/ezhud/hud.c
index 89a8df4..b983c8d 100644
--- a/plugins/ezhud/hud.c
+++ b/plugins/ezhud/hud.c
@@ -1579,3 +1579,160 @@ void HUD_Sort(void)
     // Recalculate elements so vars are parsed.
     HUD_Recalculate();
 }
+
+// ============================================================================
+// ez-hud spike (spike/fte-web): JSON state export for the in-browser editor.
+//
+// One EMSCRIPTEN_KEEPALIVE function returning the same shape as ez-hud's
+// GET /state (docs/PROTOCOL.md), so core/model.js needs no changes. `physical`
+// is deliberately absent: the page reads the canvas size itself, the same way
+// the ezQuake bridge reads the framebuffer it captures from.
+// ============================================================================
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+#define EZHUD_STATE_BUFSZ (256*1024)
+static char  ezhud_state_buf[EZHUD_STATE_BUFSZ];
+static char *ezhud_state_cur;
+
+static void EZHud_JsonRaw(const char *s)
+{
+	size_t left = EZHUD_STATE_BUFSZ - (ezhud_state_cur - ezhud_state_buf) - 1;
+	size_t len = strlen(s);
+	if (len > left)
+		len = left;
+	memcpy(ezhud_state_cur, s, len);
+	ezhud_state_cur += len;
+	*ezhud_state_cur = 0;
+}
+static void EZHud_JsonStr(const char *s)
+{	//quoted + escaped
+	char tmp[8];
+	EZHud_JsonRaw("\"");
+	for (; s && *s; s++)
+	{
+		unsigned char c = *s;
+		if (c == '"' || c == '\\')
+		{
+			tmp[0]='\\'; tmp[1]=c; tmp[2]=0;
+			EZHud_JsonRaw(tmp);
+		}
+		else if (c < 0x20)
+		{
+			snprintf(tmp, sizeof(tmp), "\\u%04x", c);
+			EZHud_JsonRaw(tmp);
+		}
+		else
+		{
+			tmp[0]=c; tmp[1]=0;
+			EZHud_JsonRaw(tmp);
+		}
+	}
+	EZHud_JsonRaw("\"");
+}
+static void EZHud_JsonNum(double v)
+{
+	char tmp[64];
+	if (v == (double)(long long)v)
+		snprintf(tmp, sizeof(tmp), "%lld", (long long)v);
+	else
+		snprintf(tmp, sizeof(tmp), "%g", v);
+	EZHud_JsonRaw(tmp);
+}
+static void EZHud_JsonCvar(const char *key, cvar_t *var, int *first)
+{	//one "name":"value" pair inside the cvars object
+	if (!var)
+		return;
+	if (!*first)
+		EZHud_JsonRaw(",");
+	*first = 0;
+	EZHud_JsonStr(key ? key : var->name);
+	EZHud_JsonRaw(":");
+	EZHud_JsonStr(var->string ? var->string : "");
+}
+
+EMSCRIPTEN_KEEPALIVE const char *EZHud_StateJSON(void)
+{
+	hud_t *hud;
+	int i;
+	int firstel = 1;
+
+	ezhud_state_cur = ezhud_state_buf;
+	*ezhud_state_cur = 0;
+
+	EZHud_JsonRaw("{\"protocol\":1,\"engine\":\"fteqw ezhud (web)\",\"screen\":{\"vid_width\":");
+	EZHud_JsonNum(vid.width);
+	EZHud_JsonRaw(",\"vid_height\":");
+	EZHud_JsonNum(vid.height);
+	EZHud_JsonRaw(",\"scr_con_current\":");
+	EZHud_JsonNum(scr_con_current);
+	EZHud_JsonRaw("},\"view\":{\"spectator\":");
+	EZHud_JsonRaw(cl.spectator ? "true" : "false");
+	EZHud_JsonRaw(",\"tracking\":");
+	EZHud_JsonRaw((cl.tracknum != -1) ? "true" : "false");
+	EZHud_JsonRaw("},\"elements\":[");
+
+	for (hud = hud_huds; hud; hud = hud->next)
+	{
+		int firstcv = 1;
+		if (!firstel)
+			EZHud_JsonRaw(",");
+		firstel = 0;
+
+		EZHud_JsonRaw("{\"name\":");
+		EZHud_JsonStr(hud->name);
+		EZHud_JsonRaw(",\"description\":");
+		EZHud_JsonStr(hud->description ? hud->description : "");
+		EZHud_JsonRaw(",\"shown\":");
+		EZHud_JsonRaw((hud->show ? (hud->show->value != 0) : 1) ? "true" : "false");
+		EZHud_JsonRaw(",\"place\":");
+		EZHud_JsonStr(hud->place ? hud->place->string : "");
+		EZHud_JsonRaw(",\"parent\":");
+		if (hud->place_hud)
+			EZHud_JsonStr(hud->place_hud->name);
+		else
+			EZHud_JsonRaw("null");
+		EZHud_JsonRaw(",\"align_x\":");
+		EZHud_JsonStr(hud->align_x ? hud->align_x->string : "left");
+		EZHud_JsonRaw(",\"align_y\":");
+		EZHud_JsonStr(hud->align_y ? hud->align_y->string : "top");
+		/* As JSON strings holding the cvar's own text, not floats: the cvar
+		 * string is what a config sets and what an export must give back.
+		 * Printing pos_x's float through %g turned "200.288666" into
+		 * "200.289" and broke the byte-identical round trip. Every consumer
+		 * in core/ already coerces with Number(). */
+		EZHud_JsonRaw(",\"pos_x\":");
+		EZHud_JsonStr(hud->pos_x ? hud->pos_x->string : "0");
+		EZHud_JsonRaw(",\"pos_y\":");
+		EZHud_JsonStr(hud->pos_y ? hud->pos_y->string : "0");
+		EZHud_JsonRaw(",\"order\":");
+		EZHud_JsonStr(hud->order ? hud->order->string : "0");
+		EZHud_JsonRaw(",\"frame\":");
+		EZHud_JsonStr(hud->frame ? hud->frame->string : "0");
+		EZHud_JsonRaw(",\"spec_required\":false,\"needs_pov\":false,\"rect\":");
+		if (hud->last_draw_sequence && hud->last_draw_sequence >= host_screenupdatecount)
+		{
+			EZHud_JsonRaw("{\"x\":");
+			EZHud_JsonNum(hud->lx);
+			EZHud_JsonRaw(",\"y\":");
+			EZHud_JsonNum(hud->ly);
+			EZHud_JsonRaw(",\"w\":");
+			EZHud_JsonNum(hud->lw);
+			EZHud_JsonRaw(",\"h\":");
+			EZHud_JsonNum(hud->lh);
+			EZHud_JsonRaw("}");
+		}
+		else
+			EZHud_JsonRaw("null");
+		EZHud_JsonRaw(",\"cvars\":{");
+		EZHud_JsonCvar(NULL, hud->frame, &firstcv);
+		EZHud_JsonCvar(NULL, hud->frame_color, &firstcv);
+		EZHud_JsonCvar(NULL, hud->opacity, &firstcv);
+		for (i = 0; i < hud->num_params; i++)
+			EZHud_JsonCvar(NULL, hud->params[i], &firstcv);
+		EZHud_JsonRaw("}}");
+	}
+	EZHud_JsonRaw("]}");
+	return ezhud_state_buf;
+}
+#endif	//__EMSCRIPTEN__
