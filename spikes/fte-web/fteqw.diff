+// Restore every element's position and visibility to what HUD_Register asked
+// for. Ported from ezQuake's engine-integration.diff (HUD_ResetLayout_f),
+// which the editor's 'Reset positions...' button has always targeted -- this
+// plugin never had the command, so on the FTE-web preview it silently did
+// nothing ("Unknown command") while the same button worked against the real
+// ezQuake bridge. `reset <name>` (HUD_Reset_f above) only centres one
+// element and is not a substitute. Deliberately limited to placement and
+// visibility -- colours, scales and per-element params are left alone.
+void HUD_ResetLayout_f(void)
+{
+	hud_t *hud;
+	int changed = 0;
+
+	for (hud = hud_huds; hud; hud = hud->next) {
+		cvar_t *vars[6];
+		int i;
+
+		vars[0] = hud->show;
+		vars[1] = hud->place;
+		vars[2] = hud->align_x;
+		vars[3] = hud->align_y;
+		vars[4] = hud->pos_x;
+		vars[5] = hud->pos_y;
+
+		for (i = 0; i < 6; i++) {
+			// Not every element registers every one of these: HUD_Register is
+			// given NULL for the ones that do not apply (see the pos_x/align_x
+			// and pos_y/align_y guards above).
+			if (vars[i] && vars[i]->defaultstr && strcmp(vars[i]->string, vars[i]->defaultstr)) {
+				Cvar_Set(vars[i], vars[i]->defaultstr);
+				changed++;
+			}
+		}
+	}
+
+	HUD_Recalculate();
+	Com_Printf("HUD layout reset: %d value%s restored to default\n", changed, changed == 1 ? "" : "s");
+}
